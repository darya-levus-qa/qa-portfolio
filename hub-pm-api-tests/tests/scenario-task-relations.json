{
  "scenario": "Построить простую карту связей между задачами",
  "description": "Сценарий из юнитов: создается цепочка задача -> подзадача 1 -> подзадача 2, проверяется диаграмма связей, затем созданные задачи удаляются. Id созданных задач сохраняются в переменные и передаются в следующие шаги, поэтому сценарий можно запускать повторно без ручной подготовки.",
  "steps": [
    {
      "step": 1,
      "name": "Подключение к API",
      "connection": "WebSocket, токен пользователя из файла аккаунтов"
    },
    {
      "step": 2,
      "name": "Создать задачу",
      "method": "Tasks / TaskSaveWsController / TaskCreate",
      "request": {
        "Description": "",
        "DifficultyId": "00000000-0000-0000-0000-000000000001",
        "Name": "тикет для проверки",
        "PerformersIds": [10002],
        "ObserversIds": [10002],
        "ParentTaskId": null,
        "PriorityId": 1001,
        "QueueId": "00000000-0000-0000-0000-000000000002",
        "StatusId": 2001,
        "TypeId": "00000000-0000-0000-0000-000000000003"
      },
      "rules": {
        "ErrorMessage": null,
        "IsSuccess": true,
        "Value.Task.Name": "тикет для проверки"
      },
      "export": {
        "Value.Task.Id": "ParentTaskId"
      }
    },
    {
      "step": 3,
      "name": "Создать подзадачу 1 внутри задачи",
      "method": "Tasks / TaskSaveWsController / TaskCreate",
      "request": {
        "Description": "",
        "DifficultyId": "00000000-0000-0000-0000-000000000001",
        "Name": "подзадача1",
        "PerformersIds": [10002],
        "ObserversIds": [10002],
        "ParentTaskId": "${Parameter.ParentTaskId}",
        "PriorityId": 1001,
        "QueueId": "00000000-0000-0000-0000-000000000002",
        "StatusId": 2001,
        "TypeId": "00000000-0000-0000-0000-000000000003"
      },
      "rules": {
        "ErrorMessage": null,
        "IsSuccess": true,
        "Value.Task.Name": "подзадача1"
      },
      "export": {
        "Value.Task.Id": "ParentTaskId2"
      }
    },
    {
      "step": 4,
      "name": "Создать подзадачу 2 внутри подзадачи 1",
      "method": "Tasks / TaskSaveWsController / TaskCreate",
      "request": {
        "Description": "",
        "DifficultyId": "00000000-0000-0000-0000-000000000001",
        "Name": "подзадача2",
        "PerformersIds": [10002],
        "ObserversIds": [10002],
        "ParentTaskId": "${Parameter.ParentTaskId2}",
        "PriorityId": 1001,
        "QueueId": "00000000-0000-0000-0000-000000000002",
        "StatusId": 2001,
        "TypeId": "00000000-0000-0000-0000-000000000003"
      },
      "rules": {
        "ErrorMessage": null,
        "IsSuccess": true,
        "Value.Task.Name": "подзадача2"
      },
      "export": {
        "Value.Task.Id": "SubTaskId"
      }
    },
    {
      "step": 5,
      "name": "Получение диаграммы связей задачи",
      "method": "Main / ProjectTaskGetService / GetTaskDiagramRelation",
      "request": {
        "TaskId": "${Parameter.ParentTaskId}",
        "GroupBy": 0
      },
      "rules": {
        "IsSuccess": true,
        "ErrorMessage": null,
        "Value.TaskList[2].TaskId": "${Parameter.ParentTaskId}",
        "Value.RelationAllInfo.StatusList[0].TaskCount": 3,
        "Value.TaskList[0].ParentId": "${Parameter.ParentTaskId}",
        "Value.TaskList[1].ParentId": "${Parameter.ParentTaskId2}"
      }
    },
    {
      "step": 6,
      "name": "Удалить задачу",
      "method": "Tasks / TaskSaveWsController / TaskRemove",
      "request": {
        "TaskIds": ["${Parameter.ParentTaskId}"]
      },
      "rules": {
        "IsSuccess": true,
        "ErrorMessage": null,
        "Value.TaskIds[0]": "${Parameter.ParentTaskId}"
      }
    },
    {
      "step": 7,
      "name": "Удалить подзадачу 1",
      "method": "Tasks / TaskSaveWsController / TaskRemove",
      "request": {
        "TaskIds": ["${Parameter.ParentTaskId2}"]
      },
      "rules": {
        "IsSuccess": true,
        "ErrorMessage": null,
        "Value.TaskIds[0]": "${Parameter.ParentTaskId2}"
      }
    },
    {
      "step": 8,
      "name": "Удалить подзадачу 2",
      "method": "Tasks / TaskSaveWsController / TaskRemove",
      "request": {
        "TaskIds": ["${Parameter.SubTaskId}"]
      },
      "rules": {
        "IsSuccess": true,
        "ErrorMessage": null,
        "Value.TaskIds[0]": "${Parameter.SubTaskId}"
      }
    }
  ]
}
